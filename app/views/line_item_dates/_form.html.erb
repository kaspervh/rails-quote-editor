
<%= simple_form_for [quote, line_item_date], html: {class: 'quote-form'} do |f| %>
  
  <div class="form-inputs">
    <%= f.association :quote %>
    <br>
    <%= f.input :date %>
  </div>
  <br>
  <div class="form-actions">
    <%= button_to 'cancel', quote_path(quote), class: 'btn' %>
    <%= f.button :submit %>
  </div>
<% end %>
