
<main class="container">
  <%= turbo_stream_from current_company, "quotes" %>
  <div class="header">
    <h1>Quotes</h1>
    <%= link_to "New quote", new_quote_path, class: "btn btn--primary", data: { turbo_frame: dom_id(Quote.new) } %>
  </div>
  

    
 

  
  <div id="quotes">
    <%= render @quotes %>
    <%= render 'quotes/empty_state' %>
    
  </div>
  <%= turbo_frame_tag Quote.new %>

</main> 
