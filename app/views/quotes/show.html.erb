<main class="container">
  <%= turbo_stream_from @quote, 'line_item_dates' %>
  <%=link_to "back to quotes", quotes_path %>
  
  <div class="header">
    <h1>
      <%= @quote.name %>
    </h1>
    <%= link_to 'New Date', new_quote_line_item_date_path(@quote), class: 'btn', data: {turbo_frame: dom_id(LineItemDate.new)}%>
  </div>
  <%= turbo_frame_tag LineItemDate.new %>

  <div>

    <%= render 'line_item_dates/line_item_dates', line_item_dates: @quote.line_item_dates %>

  </div>
  

</main>